{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist",
    "composite": true,
    "sourceMap": true,
    "tsBuildInfoFile": "tsconfig.tsbuildinfo"
  },
  "include": [
    "agent-browser-runtime/**/*.ts",
    "api/**/*.ts",
    "auth/**/*.ts",
    "artifact-registry/**/*.ts",
    "cli-composition/**/*.ts",
    "cli/**/*.ts",
    "content/**/*.ts",
    "control-group/**/*.ts",
    "core/**/*.ts",
    "dashboard/**/*.ts",
    "entity/**/*.ts",
    "entity-feed/**/*.ts",
    "document/**/*.ts",
    "lib/**/*.ts",
    "marketview/**/*.ts",
    "presentation/**/*.ts",
    "skills/**/*.ts",
    "adapters/**/*.ts",
    "transport/**/*.ts",
    "widget/**/*.ts"
  ],
  "exclude": [
    "agent-browser-runtime/tests/**/*.ts",
    "api/**/tests/**/*.ts",
    "auth/tests/**/*.ts",
    "auth/adapters/tests/**/*.ts",
    "artifact-registry/tests/**/*.ts",
    "cli-composition/tests/**/*.ts",
    "cli/tests/**/*.ts",
    "content/tests/**/*.ts",
    "control-group/tests/**/*.ts",
    "core/tests/**/*.ts",
    "entity/tests/**/*.ts",
    "entity-feed/**/tests/**/*.ts",
    "document/**/tests/**/*.ts",
    "dashboard/**/tests/**/*.ts",
    "lib/tests/**/*.ts",
    "marketview/tests/**/*.ts",
    "presentation/tests/**/*.ts",
    "widget/**/tests/**/*.ts",
    "skills/tests/**/*.ts",
    "adapters/tests/**/*.ts",
    "transport/tests/**/*.ts"
  ]
}
